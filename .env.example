# Copy to .env and fill in. Never commit .env.
# In AWS and GitHub these values live in environment variables and GitHub environment secrets.

# ---------------------------------------------------------------- mode
# 1 = demo mode: sample data, mock Google sign-in, recorded console answers. Needs no keys.
# 0 = real mode: Google sign-in, real Google adapters (if enabled), live Claude in the console.
DEMO_MODE=1

# ---------------------------------------------------------------- database
# Owner connection used by the app, migrations, seed and sync (read and write).
DATABASE_URL=postgres://app_owner:app_owner@localhost:5432/app
# Passwords for the two MCP roles. `npm run db:migrate` creates the roles with these passwords.
MCP_READONLY_PASSWORD=
MCP_AUDIT_PASSWORD=
# The MCP server connects only with these two roles, never with the owner.
# mcp_readonly: SELECT on analytics tables only. mcp_auditor: writes audit rows only.
MCP_READONLY_DATABASE_URL=postgres://mcp_readonly:<MCP_READONLY_PASSWORD>@localhost:5432/app
MCP_AUDIT_DATABASE_URL=postgres://mcp_auditor:<MCP_AUDIT_PASSWORD>@localhost:5432/app

# ---------------------------------------------------------------- sign-in (Auth.js)
# Random secret for session cookies. Generate one with: openssl rand -base64 32
AUTH_SECRET=
# Public URL of the app, for example https://app.example.com (not needed locally).
AUTH_URL=
# Google OAuth client for sign-in (scopes: openid, email, profile).
# Redirect URI to register: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma separated Google accounts allowed to sign in. Empty = any Google account.
AUTH_ALLOWED_EMAILS=

# ---------------------------------------------------------------- staging password
# 1 on staging: every page needs the username and password below.
STAGING_BASIC_AUTH=0
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# ---------------------------------------------------------------- MCP server
MCP_PORT=3001
# Where the app's demo console reaches the MCP server.
MCP_URL=http://localhost:3001/mcp
# Optional connector token for the console. Empty = the app creates its own (stored hashed).
MCP_CONSOLE_TOKEN=

# ---------------------------------------------------------------- Claude (console live mode)
# Used only when DEMO_MODE=0. The console then asks Claude for real.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---------------------------------------------------------------- Google data sync
# Real adapters are off by default (and always off in demo mode). See docs/GOOGLE_DATA.md.
GOOGLE_ADS_ENABLED=0
GA4_ENABLED=0
# OAuth client and refresh token for the data APIs. The refresh token needs the scopes
# https://www.googleapis.com/auth/adwords and https://www.googleapis.com/auth/analytics.readonly
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Google Ads: developer token (approved for production use), account id, manager id if any.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v22
# GA4 property id (numbers only, from Admin > Property details).
GA4_PROPERTY_ID=
# How many days each sync pulls. The nightly job passes 3; the first sync uses 90.
SYNC_LOOKBACK_DAYS=90
# Pause between days in a sync, in ms. 0 in normal use; a small value makes progress visible.
SYNC_STEP_DELAY_MS=0
# Secret for the nightly sync trigger: POST /api/cron/sync with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
